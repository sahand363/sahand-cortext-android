<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chatBackground"
    android:orientation="vertical">

    <!-- Top bar: back to the chat list, title, new chat, theme
         toggle, settings. Minimal, in the panel's panel colour. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/chatTopBarBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="←"
            android:textColor="?attr/chatTextSecondary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cortext_display"
            android:text="@string/title"
            android:textColor="?attr/chatTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNewChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="+"
            android:textColor="?attr/chatTextSecondary"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnTheme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="☀"
            android:textColor="?attr/chatTextSecondary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="⚙"
            android:textColor="?attr/chatTextSecondary"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/chatDivider" />

    <ListView
        android:id="@+id/listMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:stackFromBottom="true"
        android:transcriptMode="disabled" />

    <TextView
        android:id="@+id/tvThinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="24dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:text="@string/thinking"
        android:textColor="?attr/chatTextSecondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/chatDivider" />

    <!-- Input row: panel colour, input field with the panel's 8dp
         hairline-border look, accent send button (the panel's ➤). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/chatTopBarBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_message"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="4"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="?attr/chatInputText"
            android:textColorHint="?attr/chatTextSecondary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_button_primary"
            android:text="➤"
            android:textColor="?attr/chatAccentText"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
