<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chatBackground"
    android:orientation="vertical">

    <!-- Top bar: title, new chat, theme toggle, settings. Same as the
         chat screen's top bar, in the panel's panel colour. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/chatTopBarBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cortext_display"
            android:text="@string/title"
            android:textColor="?attr/chatTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNewChatList"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="+"
            android:textColor="?attr/chatTextSecondary"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnThemeList"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="☀"
            android:textColor="?attr/chatTextSecondary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSettingsList"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="⚙"
            android:textColor="?attr/chatTextSecondary"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/chatDivider" />

    <!-- Status line: "Loading chats…" / "No chats yet…" / error text.
         Hidden once the list loads. -->
    <TextView
        android:id="@+id/tvChatListStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="@string/loading_chats"
        android:textColor="?attr/chatTextSecondary"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/listChats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null" />
</LinearLayout>
