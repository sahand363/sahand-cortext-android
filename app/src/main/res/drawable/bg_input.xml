<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: the panel's input look — input background fill, hairline
     border, 8dp radius. Theme attributes keep it correct in both themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="?attr/chatInputBackground" />
    <stroke android:width="1dp" android:color="?attr/chatDivider" />
</shape>
